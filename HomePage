            background-position: center;
            padding: 60px 20px;
            color: #333;
            text-shadow: 1px 1px 4px #ccc;
        }

        /* Button styling */
        .cta-button {
            background-color: #d91e18;
            color: #fff;
            padding: 15px 30px;
            text-decoration: none;
            font-size: 1.2em;
            border-radius: 5px;
            margin-top: 20px;
            display: inline-block;
            transition: background-color 0.3s;
        }

        .cta-button:hover {
            background-color: #b51510;
        }
