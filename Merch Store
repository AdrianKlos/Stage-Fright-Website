<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stage Fright Official Merch</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: rgba(244, 244, 249, 0.5);
            color: #ffffff;
            margin: 0;
            padding: 0;
            background-size: cover;
            background-image: url("https://i.postimg.cc/ncMfrWDS/Screenshot-2024-11-14-170543.png");
            image-rendering: high-quality;
            background-blend-mode: darken;
        }

        header {
            text-align: center;
            padding: 1rem;
            background-color: #f0f0f0;
            border-bottom: 2px solid #d1d1d1;
        }

        h1 {
            color: #e63946;
            font-size: 35px;
        }

        h2 {
            font-family: Arial, sans-serif;
        }

        h3, h4, p {
            color: #f4f4f4;
            background-color: #161616;
            font-size: 20px;
        }

        #products {


            padding: 2rem;
            text-align: center;
            background-color: rgb(0 0 0 / 0.5);
            color: #fff;
        }
        .product-list {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .product-item {
            background-color: #191818;
            padding: 1rem;
            color: #d1d1d1;
            border-radius: 8px;
            width: 200px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border: 1px solid #ffffff;
        }

        .product-item img {
            width: 100%;
            border-radius: 8px;
            image-rendering: high-quality;
        }

        button {
            background-color: #e63946;
            color: #fff;
            border: none;
            padding: 0.5rem;
            cursor: pointer;
            margin-top: 0.5rem;
            border-radius: 5px;
            transition: background-color 0.3s;
            font-size: 18px;
        }
        button:hover {
            background-color: #d62828;
        }

        #cart {
            padding: 1rem;
            text-align: center;
            background-color: rgb(0 0 0 / 0.5);
            color: #fff;
        }

        #cart-items {
            padding: 1rem;
            font-style: italic;
            font-size: 20px;
        }

        #total-price {
            font-size: 1.2rem;
            margin-top: 1rem;
            color: #048ad1;
            font-weight: bold;
            font-size: 30px;
        }

        #clear-cart {
            background-color: #555;
            margin-right: 1rem;
            font-size: 18px;
        }

        #clear-cart:hover {
            background-color: #444;
        }

        #check-out {
            font-size: 20px;
            font-weight: bold;
            margin-top: 1rem;
        }

        #check-out:hover {
            background-color: #b71c1c;
        }

        .modal-overlay {
            display: flex;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal {
            background: #fff;
            width: 90%;
            max-width: 500px;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            animation: fadeIn 0.3s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-header {
            background: #a1060e;
            color: white;
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 18px;
        }

        .close-button {
            background: transparent;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
        }

        .modal-body {
            padding: 16px;
            color: black;
        }

        .payment-method {
            margin-bottom: 12px;
            font-size: 1rem;
        }

        .modal-footer {


            padding: 16px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            background: #f1f1f1;
        }
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .btn-secondary {
            background: #ccc;
            color: black;
        }

        .btn-primary {
            background: #099116;
            color: white;
        }
    </style>
</head>
<body>
<header>
    <h1>Stage Fright Official Merch</h1>
    <p style="color: black; background: none;">Face the Fright. Wear the Fright. Be the Fright.</p>
</header>
<section id="products">
    <h1>In Stock</h1>
    <div class="product-list">
        <div class="product-item">
            <img src="https://i.postimg.cc/J7DBc2yJ/unnamed.png" alt="Black Tee">
            <h3>Classic Black T-Shirt</h3>
              <label for="size" style="color: white;">Size:</label>
  <select name="size" id="size">
    <option value="small">S</option>
    <option value="medium">M</option>
    <option value="large">L</option>
    <option value="extra large">XL</option>
  </select>
            <p>$24.99</p>
            <button onclick="addToCart('Classic Black Tee', 24.99)">Add to Cart</button>
        </div>
        <div class="product-item">
            <img src="https://i.postimg.cc/rF507RNw/unnamed-1.png" alt="Black Hoodie">
            <h3>Classic Black Hoodie</h3>
            <h4>(Adult Medium)</h4>
            <p>$44.99</p>
            <button onclick="addToCart('Classic Black Hoodie', 44.99)">Add to Cart</button>
        </div>
        <div class="product-item">
            <img src="https://i.postimg.cc/bw8DPYmH/unnamed-2.png" alt="Black Hat">
            <h3>Classic Black Hat</h3>
            <p>$14.99</p>
            <button onclick="addToCart('Classic Black Hat', 14.99)">Add to Cart</button>
        </div>
        <div class="product-item">
            <img src="https://i.postimg.cc/bw8DPYmH/unnamed-2.png" alt="Black Hat">
            <h3>Classic Black Bandana</h3>
            <p>$9.99</p>
            <button onclick="addToCart('Classic Black Bandana', 9.99)">Add to Cart</button>
        </div>
        <div class="product-item">
            <img src="https://i.postimg.cc/bw8DPYmH/unnamed-2.png" alt="Black Hat">
            <h3>Ceramic Black Mug</h3>
            <p>$9.99</p>
            <button onclick="addToCart('Ceramic Black Mug', 9.99)">Add to Cart</button>
        </div>
        <div class="product-item">
            <img src="https://i.postimg.cc/bw8DPYmH/unnamed-2.png" alt="Black Hat">
            <h3>Stage Fright Wall Poster</h3>
            <p>$19.99</p>
            <button onclick="addToCart('Stage Fright Wall Poster', 19.99)">Add to Cart</button>
        </div>
                <div class="product-item">
            <img src="https://i.postimg.cc/bw8DPYmH/unnamed-2.png" alt="Black Hat">
            <h3>Stage Fright Logo Stickers</h3>
            <h4>Quantity: 25</h4>
            <p>$2.99</p>
            <button onclick="addToCart('Stage Fright Logo Sticker', 2.99)">Add to Cart</button>
        </div>
    </div>
</section>
<section id="cart">
    <h2>Shopping Cart</h2>
    <div id="cart-items"></div>
    <p id="total-price">Total: $0.00</p>
    <div id="errormsg"></div>
    <button id="clear-cart" onclick="clearCart()">Clear Cart</button>
    <button id="check-out" onclick="checkout()">Checkout</button>
</section>
<div id="modalOverlay" class="modal-overlay">
    <div class="modal">
        <div class="modal-header">
            <h2>Choose a Payment Method</h2>
            <button class="close-button" onclick="closeModal()">✖</button>
        </div>
        <div class="modal-body">
            <form id="paymentForm">
                <div class="payment-method">
                    <label>
                        <input type="radio" name="paymentMethod" value="creditCard" required>
                        Credit Card
                    </label>
                </div>
                <div class="payment-method">
                    <label>
                        <input type="radio" name="paymentMethod" value="paypal">
                        PayPal
                    </label>
                </div>
                <div class="payment-method">
                    <label>
                        <input type="radio" name="paymentMethod" value="applePay">
                        Apple Pay
                    </label>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
            <button class="btn btn-primary" onclick="confirmPayment()">Confirm Payment</button>
        </div>
    </div>
</div>
<script>
    const modal = document.getElementById("modalOverlay");
    window.onload = function() {
        modal.style.display = "none";
    };
    let cart = [];

    function clearCart() {
        cart = [];
        displayCart();
    }

    function addToCart(name, price) {
        cart.push({ name, price, });
        displayCart();
    }

    function displayCart() {
        const cartItems = document.getElementById("cart-items");
        const totalPrice = document.getElementById("total-price");
        let total = 0;
        cartItems.innerHTML = "";

        if (cart.length === 0) {
            cartItems.innerHTML = "<p>Your cart is empty.</p>";
        } else {
            cart.forEach((item, index) => {
                const itemElement = document.createElement("div");
                itemElement.textContent = `${item.name} - $${item.price.toFixed(2)}`;
                const removeButton = document.createElement("button");
                removeButton.textContent = "Remove";
                removeButton.onclick = () => {
                    cart.splice(index, 1);
                    displayCart();
                };
                itemElement.appendChild(removeButton);
                cartItems.appendChild(itemElement);
                total += item.price;
            });
        }

        totalPrice.textContent = `Total: $${total.toFixed(2)}`;
    }

    function checkout() {
        if (cart.length === 0) {
            const errorMsg = document.getElementById("errormsg");
            errorMsg.textContent = "Your cart is empty! Add some items before checking out.";
        } else {
            modal.style.display = "flex";
        }
    }

    function closeModal() {
        modal.style.display = "none";
    }

    function confirmPayment() {
        const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked');
        if (!paymentMethod) {
            alert("Please select a payment method.");
        } else {
            alert(`Payment successful using ${paymentMethod.value}!`);
            clearCart();
            closeModal();
        }
    }
</script>
</body>
</html>
