<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stage Fright Official Merch</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f9;
        color: #333;
        margin: 0;
        padding: 0;
      }

      header {
        text-align: center;
        padding: 1rem;
        background-color: #f0f0f0;
        border-bottom: 2px solid #d1d1d1;
      }

      h1 {
        color: #e63946;
      }
      
      #products {
        padding: 2rem;
        text-align: center;
      }

      .product-list {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
      }

      .product-item {
        background-color: #fff;
        padding: 1rem;
        border-radius: 8px;
        width: 200px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border: 1px solid #ddd;
      }

      .product-item img {
        width: 100%;
        border-radius: 8px;
      }

      button {
        background-color: #e63946;
        color: #fff;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
        margin-top: 0.5rem;
        border-radius: 5px;
        transition: background-color 0.3s;
      }

      button:hover {
        background-color: #d62828;
      }

      #cart {
        background-color: #f0f0f0;
        padding: 1rem;
        text-align: center;
      }

      #cart-items {
        padding: 1rem;
      }

      #total-price {
        font-size: 1.2rem;
        margin-top: 1rem;
        color: #0077b6;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Stage Fright Official Merch</h1>
      <p>Face the Fright. Wear the Fright. Be the Fright.</p>
    </header>
    <section id="products">
      <h2>In Stock</h2>
      <div class="product-list">
        <div class="product-item">
          <img src="https://i.postimg.cc/J7DBc2yJ/unnamed.png" alt="Black Tee">
          <h3>Classic Black T-Shirt</h3>
          <h4>(Adult Medium)</h4>
          <p>$25.00</p>
          <button onclick="addToCart('Classic Black Tee', 25)">Add to Cart</button>
        </div>
        <div class="product-item">
          <img src="https://i.postimg.cc/rF507RNw/unnamed-1.png" alt="Black Hoodie">
          <h3>Classic Black Hoodie</h3>
          <h4>(Adult Medium)</h4>
          <p>$45.00</p>
          <button onclick="addToCart('Classic Black Hoodie', 45)">Add to Cart</button>
        </div>
        <div class="product-item">
          <img src="https://i.postimg.cc/bw8DPYmH/unnamed-2.png" alt="Black Hat">
          <h3>Classic Black Hat</h3>
          <p>$15.00</p>
          <button onclick="addToCart('Classic Black Hat', 15)">Add to Cart</button>
        </div>
      </div>
    </section>
    <section id="cart">
      <h2>Shopping Cart</h2>
      <div id="cart-items"></div>
      <p id="total-price">Total: $0.00</p>
      <button onclick="checkout()">Checkout</button>
    </section>
    <script>
      let cart = [];

      function addToCart(name, price) {
        const item = {
          name,
          price
        };
        cart.push(item);
        displayCart();
      }

      function displayCart() {
        const cartItems = document.getElementById("cart-items");
        cartItems.innerHTML = "";
        let total = 0;
        cart.forEach((item, index) => {
          const itemEl = document.createElement("div");
          itemEl.textContent = `${item.name} - $${item.price.toFixed(2)}`;
          cartItems.appendChild(itemEl);
          total += item.price; 
        });
        document.getElementById("total-price").textContent = `Total: $${total.toFixed(2)}`;
      }

      function checkout() {
      
      	if (cart.length==0) {
        
        	alert("Please purchase at least one item before checking out.");
            
        }
        
        else {
        
        	alert("Thank you for your purchase!");
        	cart = [];
        	displayCart();
       }     
       
      }
    </script>
  </body>
</html>
