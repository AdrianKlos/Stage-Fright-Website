<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <title>Upcoming Concerts</title>
    <style>
      body {
        background-color: #f9f9f9;
        color: #333333;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        margin-top: 25%;
        margin-bottom: 50%;
      }

      .dropdown-toggle::after {
        content: none;
      }

      .purchase-btn {
        background-color: #135abd;
        color: white;
        border: none;
        padding: 10px 20px;
        font-size: 1rem;
        display: flex;
        align-items: center;
        margin: 0;
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
      }

      .modal {
        background: #fff;
        border-radius: 8px;
      }

      .modal-header {
        background: #a41b03;
        color: #fff;
        padding: 15px;
        font-size: 18px;
        font-weight: bold;
      }

      .modal-body input {
        width: 100%;
        padding: 8px;
        margin-bottom: 15px;
        border: 1px solid #ddd;
        border-radius: 4px;
      }

      .btn-primary {
        background: #9b1509;
        color: #fff;
      }

      .btn-success {
        background: #1f9039;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <div style="text-align: center;">
      <h2>Upcoming Concerts</h2>
      <hr>
      <ul style="list-style-type:none;">
        <li>January 12, 2025 | Chicago, IL: United Center</li>
        <hr>
        <li>January 18, 2025 | New York, NY: Madison Square Garden</li>
        <hr>
        <li>January 25, 2025 | Boston, MA: TD Garden</li>
        <hr>
        <li>February 2, 2025 | Atlanta, GA: State Farm Arena</li>
        <hr>
        <li>February 9, 2025 | Dallas, TX: American Airlines Center</li>
      </ul>
      <hr>
      <div class="container mt-5">
        <div class="dropdown">
          <button class="btn purchase-btn dropdown-toggle" type="button" id="purchaseDropdown" data-bs-toggle="dropdown">
            <i class="fas fa-shopping-cart"></i> Purchase Options </button>
          <ul class="dropdown-menu" aria-labelledby="purchaseDropdown">
            <h6 class="dropdown-header">Dates:</h6>
            <li>
              <a class="dropdown-item" href="#" onclick="openFormModal('January 12, 2025')">January 12, 2025</a>
            </li>
            <li>
              <a class="dropdown-item" href="#" onclick="openFormModal('January 18, 2025')">January 18, 2025</a>
            </li>
            <li>
              <a class="dropdown-item" href="#" onclick="openFormModal('January 25, 2025')">January 25, 2025</a>
            </li>
            <li>
              <a class="dropdown-item" href="#" onclick="openFormModal('February 2, 2025')">February 2, 2025</a>
            </li>
            <li>
              <a class="dropdown-item" href="#" onclick="openFormModal('February 9, 2025')">February 9, 2025</a>
            </li>
          </ul>
        </div>
      </div>
      </div>
    </body>
    <!-- Modal -->
    <div class="modal fade" id="formModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header"> Reservation Details </div>
          <div class="modal-body">
            <form id="reservationForm">
              <label for="selectedDate">Selected Date</label>
              <input type="text" id="selectedDate" readonly>
              <label for="numPeople">Number of People</label>
              <input type="number" id="numPeople" placeholder="Enter the number of people attending..." required>
              <label for="estimatedPrice">Estimated Price</label>
              <input type="text" id="estimatedPrice" placeholder="The estimated price will appear here..." readonly>
            </form>
          </div>
          <div class="modal-footer">
            <button class="btn btn-primary" onclick="calculatePrice()">Calculate Price</button>
            <button class="btn btn-success" onclick="confirmReservation()">Confirm</button>
          </div>
        </div>
      </div>
    </div>
    <script>
      function openFormModal(date) {
        document.getElementById('selectedDate').value = date;
        const modal = new bootstrap.Modal(document.getElementById('formModal'));
        modal.show();
      }

      function calculatePrice() {
        const numPeople = parseInt(document.getElementById('numPeople').value);
        const pricePerPerson = 30;
        const estimatedPriceField = document.getElementById('estimatedPrice');
        if (!isNaN(numPeople) && numPeople > 0) {
          const estimatedPrice = numPeople * pricePerPerson;
          estimatedPriceField.value = `$${estimatedPrice.toFixed(2)}`;
        } else {
          estimatedPriceField.value = "Please enter a valid number.";
        }
      }

      function confirmReservation() {
        alert('Reservation confirmed!');
        document.getElementById("formModal").style.display = "none";
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</html>
