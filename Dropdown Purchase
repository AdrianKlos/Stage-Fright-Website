//Calculates the price based on the number of people
function calculatePrice() {
    const numPeople = parseInt(document.getElementById('numPeople').value);
    const people = document.getElementById('numPeople').value;
    let pricePerPerson;

    switch(people) {
        case 1:
            pricePerPerson = 30;
            break;
        case 2:
            pricePerPerson = 60;
            break;
        case 3:
            pricePerPerson = 90;
            break;
            case 4:
            pricePerPerson = 120;
            break;
            case 5:
            pricePerPerson = 150;
            break;
        default:
            pricePerPerson = 30;
    }

    if (!isNaN(numPeople) && numPeople > 0) {
        const estimatedPrice = numPeople * pricePerPerson;
        document.getElementById('estimatedPrice').value = `$${estimatedPrice.toFixed(2)}`;
    } else {
        document.getElementById('estimatedPrice').value = "Please enter a valid number of people.";
    }
}

