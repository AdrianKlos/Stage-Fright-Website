<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <title>Upcoming Concerts</title>
</head>
<body>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <style>
        body {
            background-color: #f9f9f9;
            color: #333333;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            margin-top: 25%;
            margin-bottom: 50%;
        }
        .dropdown-toggle::after {
            content: none; /* Remove default arrow */
        }

        .purchase-btn {
            background-color: #135abd;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            display: flex;
            align-items: center;
            margin: 0;
            position: absolute;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .purchase-btn i {
            margin-right: 8px;
        }

        .dropdown-menu {
            min-width: 250px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            border-radius: 8px;
            overflow: hidden;
        }

        .dropdown-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 20px;
            transition: background-color 0.2s;
        }

        .dropdown-item:hover {
            background-color: #ffffff;
        }

        .price {
            font-weight: bold;
            color: #28a745;
        }

        .dropdown-header {
            font-size: 1.2rem;
            font-weight: bold;
            background-color: #f8f9fa;
            padding: 10px 20px;
        }
    </style>
</head>
<body>
  <br>
  <div style="text-align: center;">

    <h2>Upcoming Concerts</h2>
	<hr>
    <ul style="list-style-type:none;">
      <li>January 12, 2025 | Chicago, IL: United Center </li>
      <hr>
      <li>January 18, 2025 | New York, NY: Madison Square Garden</li>
      <hr>
      <li>January 25, 2025 | Boston, MA: TD Garden</li>
      <hr>
      <li>February 2, 2025 | Atlanta, GA: State Farm Arena</li>
      <hr>
