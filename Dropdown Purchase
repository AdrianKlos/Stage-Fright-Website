<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <title>Header image</title>
</head>
<body>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <style>
        body {
            background-color: #f9f9f9;
            color: #333333;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        .dropdown-toggle::after {
            content: none; /* Remove default arrow */
        }

        .purchase-btn {
            background-color: #135abd;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            display: flex;
            align-items: center;
            margin: 0;
            position: absolute;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .purchase-btn i {
            margin-right: 8px;
        }

        .dropdown-menu {
            min-width: 250px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            border-radius: 8px;
            overflow: hidden;
        }

        .dropdown-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 20px;
            transition: background-color 0.2s;
        }

        .dropdown-item:hover {
            background-color: #ffffff;
        }

        .price {
            font-weight: bold;
            color: #28a745;
        }

        .dropdown-header {
            font-size: 1.2rem;
            font-weight: bold;
            background-color: #f8f9fa;
            padding: 10px 20px;
        }
    </style>
</head>
<body>
  <br>
  <div style="text-align: center;">

    <h2>Upcoming Concerts</h2>

    <ul style="list-style-type:none;">
      <li>January 12, 2025 | Chicago, IL: United Center </li>
      <hr>
      <li>January 18, 2025 | New York, NY: Madison Square Garden</li>
      <hr>
      <li>January 25, 2025 | Boston, MA: TD Garden</li>
      <hr>
      <li>February 2, 2025 | Atlanta, GA: State Farm Arena</li>
      <hr>
      <li>February 9, 2025 | Dallas, TX: American Airlines Center</li>
    </ul>  
    <!---- This is the dropdown menu button -->
    <div class="container mt-5">
      <div class="dropdown">
          <button class="btn purchase-btn dropdown-toggle" type="button" id="purchaseDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <i class="fas fa-shopping-cart"></i> Purchase Options
          </button>
          <div class="dropdown-menu" aria-labelledby="purchaseDropdown">
              <h6 class="dropdown-header">Dates:</h6>
              <a class="dropdown-item" href="#" onclick="openFormModal('January 12, 2025')">January 12, 2025</a>
              <a class="dropdown-item" href="#" onclick="openFormModal('January 18, 2025')">January 18, 2025</a>
              <a class="dropdown-item" href="#" onclick="openFormModal('January 25, 2025')">January 25, 2025</a>
              <a class="dropdown-item" href="#" onclick="openFormModal('February 2, 2025')">February 2, 2025</a>
              <a class="dropdown-item" href="#" onclick="openFormModal('February 9, 2025')">February 9, 2025</a>
          </div>
      </div>
  </div>
    <!---- Purchasing form modal -->
  <div class="modal fade" id="formModal" tabindex="-1" aria-labelledby="formModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="formModalLabel">Reservation Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="reservationForm">
                    <div class="mb-3">
                        <label for="dateSelected" class="form-label">Selected Date</label>
                        <input type="text" class="form-control" id="dateSelected" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="numPeople" class="form-label">Number of People</label>
                        <input type="number" class="form-control" id="numPeople" placeholder="Enter number of people" required>
                    </div>
                    </div>
                    <div class="mb-3">
                        <label for="estimatedPrice" class="form-label">Estimated Price</label>
                        <input type="text" class="form-control" id="estimatedPrice" readonly>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="calculatePrice()">Calculate Price</button>
                    <button type="button" class="btn btn-success mt-2" data-bs-dismiss="modal">Confirm</button>
                </form>
            </div>
        </div>
    </div>
</div>
</body>
<script>
  //Function to open the modal
  function openFormModal(date) {
    document.getElementById('dateSelected').value = date;
    $('#formModal').modal('show');
}

//Calculates the price based on the number of people
function calculatePrice() {
    const numPeople = parseInt(document.getElementById('numPeople').value);
    const people = document.getElementById('numPeople').value;
    let pricePerPerson;

    switch(people) {
        case 1:
            pricePerPerson = 30;
            break;
        case 2:
            pricePerPerson = 60;
            break;
        case 3:
            pricePerPerson = 90;
            break;
            case 4:
            pricePerPerson = 120;
            break;
            case 5:
            pricePerPerson = 150;
            break;
        default:
            pricePerPerson = 30;
    }

    if (!isNaN(numPeople) && numPeople > 0) {
        const estimatedPrice = numPeople * pricePerPerson;
        document.getElementById('estimatedPrice').value = `$${estimatedPrice.toFixed(2)}`;
    } else {
        document.getElementById('estimatedPrice').value = "Please enter a valid number of people.";
    }
}

function confirmed() {

alert("Purchase Confirmed");

}


// More Javascript
</script>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</html>
